{
  "name": "jean",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonidb/jean.git"
  },
  "bin": {
    "jean": "./src/cli/jean.ts"
  },
  "scripts": {
    "infra": "bun run src/adapter/server.ts",
    "board": "bun run src/cli/jean.ts board",
    "status": "bun run src/cli/jean.ts status",
    "test": "bun test src/es src/infra src/channel src/cli scripts",
    "test:domain": "bun test src/domain",
    "test:adapter": "bun test src/adapter",
    "test:all": "bun test",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "latest",
    "@types/mailparser": "^3.4.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@slack/bolt": "^4.6.0",
    "croner": "^10.0.1",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "minisearch": "^7.2.0"
  }
}
